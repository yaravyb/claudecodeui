# Claude Code UI - Docker Environment Configuration
# Copy this file to .env and fill in the values before running docker compose up

# Authentication for Claude Code CLI (set ONE of the following):

# Option 1: Anthropic API key (pay-per-use)
# ANTHROPIC_API_KEY=sk-ant-xxxxx

# Option 2: OAuth token from Claude Max/Pro/Team subscription
CLAUDE_CODE_OAUTH_TOKEN=your-oauth-token-here

# Required: Secret key for JWT token signing (generate a secure random string)
# Example: openssl rand -hex 32
JWT_SECRET=change-me-to-a-secure-random-string

# Path to the codebase on the host machine
# This will be mounted at /workspace inside the container
# Default: ./sandbox (users can upload their code into the sandbox/ directory)
CODEBASE_PATH=./sandbox

# Port to expose on the host (default: 3001)
HOST_PORT=3001
